# Токен бота от @BotFather: нужен для проверки входа через Telegram
BOT_TOKEN=
# Имя бота без @: из него собираются ссылки-приглашения
BOT_USERNAME=
# Telegram ID через запятую: кто может создать базу без приглашения
OWNER_TELEGRAM_IDS=
# Ключ Anthropic. Без него подсказки строятся только по истории базы
ANTHROPIC_API_KEY=
PORT=3000
DB_PATH=./data/monzoid.db
# Только для локальной разработки: вход без Telegram через заголовок X-Dev-User
DEV_AUTH=0
